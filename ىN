            { id: '1AttZqfFRs1qJBZsVzttBDYOv-VC9-ts8', title: 'فخامة التفاصيل في تجهيز القاعات' },
            { id: '1vI4FO4I0vBq0WdNOZBnE6ciDCrOYwjB0', title: 'تجهيزات حفلات الزفاف والملجة' },
